-- CloudHut 导航数据库 - 默认导入文件
-- 版本: 1.0
-- 用途: 便捷导入数据库，包含基础表结构和初始数据

-- 创建数据库（如果不存在）
CREATE DATABASE IF NOT EXISTS cloudhut CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;

-- 使用数据库
USE cloudhut;

-- 创建网站表
CREATE TABLE IF NOT EXISTS websites (
    id VARCHAR(255) PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    url VARCHAR(255) NOT NULL,
    desc TEXT,
    tags JSON,
    detail TEXT,
    mainCategoryId VARCHAR(255) NOT NULL,
    categoryId VARCHAR(255) NOT NULL,
    subCategoryId VARCHAR(255) NOT NULL,
    createdAt TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updatedAt TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    UNIQUE KEY unique_url (url)
);

-- 创建图标缓存表
CREATE TABLE IF NOT EXISTS favicons (
    url VARCHAR(255) PRIMARY KEY,
    iconUrl VARCHAR(255) NOT NULL,
    timestamp BIGINT NOT NULL,
    createdAt TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 创建同步元数据表
CREATE TABLE IF NOT EXISTS sync_metadata (
    key VARCHAR(255) PRIMARY KEY,
    value JSON,
    updatedAt TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

-- 创建主分类表
CREATE TABLE IF NOT EXISTS main_categories (
    id VARCHAR(255) PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    icon VARCHAR(255) NOT NULL DEFAULT 'fas fa-compass',
    orderIndex INT DEFAULT 0,
    createdAt TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updatedAt TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

-- 创建一级分类表
CREATE TABLE IF NOT EXISTS categories (
    id VARCHAR(255) PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    mainCategoryId VARCHAR(255) NOT NULL,
    orderIndex INT DEFAULT 0,
    createdAt TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updatedAt TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (mainCategoryId) REFERENCES main_categories(id) ON DELETE CASCADE
);

-- 创建二级分类表
CREATE TABLE IF NOT EXISTS sub_categories (
    id VARCHAR(255) PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    categoryId VARCHAR(255) NOT NULL,
    orderIndex INT DEFAULT 0,
    createdAt TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updatedAt TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (categoryId) REFERENCES categories(id) ON DELETE CASCADE
);

-- 插入初始主分类数据
INSERT INTO main_categories (id, name, icon, orderIndex) VALUES
('general', '综合导航', 'fas fa-compass', 0),
('ai', 'AI类导航', 'fas fa-robot', 1)
ON DUPLICATE KEY UPDATE
name = VALUES(name),
icon = VALUES(icon),
orderIndex = VALUES(orderIndex);

-- 插入初始一级分类数据
INSERT INTO categories (id, name, mainCategoryId, orderIndex) VALUES
('daily', '日常办公', 'general', 0),
('entertainment', '娱乐休闲', 'general', 1),
('ai_tools', 'AI工具', 'ai', 0)
ON DUPLICATE KEY UPDATE
name = VALUES(name),
mainCategoryId = VALUES(mainCategoryId),
orderIndex = VALUES(orderIndex);

-- 插入初始二级分类数据
INSERT INTO sub_categories (id, name, categoryId, orderIndex) VALUES
('office', 'Office 在线', 'daily', 0),
('cloud', '云盘存储', 'daily', 1),
('video', '视频平台', 'entertainment', 0),
('chat', 'AI聊天', 'ai_tools', 0),
('image', 'AI绘画', 'ai_tools', 1)
ON DUPLICATE KEY UPDATE
name = VALUES(name),
categoryId = VALUES(categoryId),
orderIndex = VALUES(orderIndex);

