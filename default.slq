-- 插入初始同步元数据
INSERT INTO sync_metadata (key, value) VALUES
('last_cloud_sync', '0'),
('database_version', '1.0')
ON DUPLICATE KEY UPDATE
value = VALUES(value);

-- 创建索引（优化查询性能）
CREATE INDEX IF NOT EXISTS idx_websites_category ON websites(mainCategoryId, categoryId, subCategoryId);
CREATE INDEX IF NOT EXISTS idx_websites_url ON websites(url);
CREATE INDEX IF NOT EXISTS idx_favicons_timestamp ON favicons(timestamp);
CREATE INDEX IF NOT EXISTS idx_categories_main ON categories(mainCategoryId);
CREATE INDEX IF NOT EXISTS idx_sub_categories_category ON sub_categories(categoryId);

-- 数据库导入完成提示
SELECT 'CloudHut 导航数据库导入完成' AS message;
SELECT '数据库包含 2 个主分类、3 个一级分类、5 个二级分类和 11 个网站' AS summary;
